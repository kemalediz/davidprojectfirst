rules_version = '2';

// Firestore security rules for Marvelpedia.
service cloud.firestore {
  match /databases/{database}/documents {

    // Character data is PUBLIC to read (Wikipedia-style). Writes (used by the
    // seeder) require sign-in — tighten to a specific admin uid for real use.
    match /characters/{characterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-user favourites: each user can only read and write their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
